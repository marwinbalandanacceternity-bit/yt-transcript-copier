{
  "manifest_version": 3,
  "name": "YT Transcript Copier",
  "version": "1.0",
  "description": "Copy cleaned YouTube transcripts to clipboard",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
